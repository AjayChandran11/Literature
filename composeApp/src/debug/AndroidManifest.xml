<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only. Compose's UI-test harness hosts its content in a bare ComponentActivity, and
  Robolectric resolves activities through the merged manifest — without this declaration
  runComposeUiTest fails with "Unable to resolve activity". It is confined to the debug
  variant, so it can never reach a release build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            tools:ignore="MissingClass" />
    </application>
</manifest>

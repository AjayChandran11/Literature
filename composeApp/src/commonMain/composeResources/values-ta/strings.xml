    <string name="help_button_description">ஆடுவது எப்படி</string>
    <string name="help_title">ஆடுவது எப்படி</string>
    <string name="help_objective_title">நோக்கம்</string>
    <string name="help_objective_body">எதிரணியை விட அதிக ஹாஃப்-சூட்களைக் க்ளெய்ம் செய்து வெல்லுங்கள் — மொத்தம் 8 உள்ளன.</string>
    <string name="help_deck_title">சீட்டுக் கட்டு</string>
    <string name="help_deck_body">4 சூட்களில் 48 சீட்டுகள் (♠&#xFE0F; ♥&#xFE0F; ♦&#xFE0F; ♣&#xFE0F;). 8 இல்லை.\n\nஒவ்வொரு சூட்டும் இரண்டு ஹாஃப்-சூட்களாகப் பிரிகிறது:\n• லோ: 2, 3, 4, 5, 6, 7\n• ஹை: 9, 10, J, Q, K, A\n\nஅதாவது தலா 6 சீட்டுகள் கொண்ட 8 ஹாஃப்-சூட்கள்.</string>
    <string name="help_teams_title">அணிகள்</string>
    <string name="help_teams_body">சம அளவிலான இரண்டு அணிகள் (2v2 அல்லது 3v3). எதிரணியிடம் மட்டுமே சீட்டு கேட்கலாம் — உங்கள் அணியினரிடம் கேட்கக் கூடாது.</string>
    <string name="help_asking_title">சீட்டு கேட்பது</string>
    <string name="help_asking_body">உங்கள் முறையில், ஒரு சூட்டைத் தேர்வு செய்து, வேண்டிய சீட்டுகளைத் தேர்ந்தெடுத்து, ஒரு எதிராளியிடம் கேளுங்கள்.\n\nசீட்டு கிடைத்ததா? மீண்டும் கேளுங்கள்.\nஇல்லையா? இப்போது அவர் முறை.\n\nகேட்க அந்த ஹாஃப்-சூட்டில் குறைந்தது ஒரு சீட்டு உங்களிடம் இருக்க வேண்டும்.</string>
    <string name="help_claiming_title">ஹாஃப்-சூட்டைக் க்ளெய்ம் செய்வது</string>
    <string name="help_claiming_body">ஒரு ஹாஃப்-சூட் முழுவதும் உங்கள் அணியிடம் உள்ளதா? க்ளெய்ம் செய்யுங்கள் — ஒவ்வொரு சீட்டையும் சரியான அணியினருக்கு ஒதுக்குங்கள்.\n\nசரியாகச் செய்தால் உங்கள் அணிக்குப் புள்ளி.\nதவறானால் எதிரணிக்குப் புள்ளி.</string>
    <string name="help_no_cards_title">சீட்டுகள் தீர்ந்தால்</string>
    <string name="help_no_cards_body">சீட்டுகள் தீர்ந்துவிட்டதா? கவலை வேண்டாம் — உங்கள் அணியினர் தொடர்ந்து ஆடுவார்கள். க்ளெய்ம்களில் நீங்கள் இன்னும் பங்கு பெறலாம்.</string>
    <string name="help_winning_title">வெற்றி</string>
    <string name="help_winning_body">அதிக ஹாஃப்-சூட்களைக் க்ளெய்ம் செய்யும் அணி வெல்லும். 4–4 என்றால் சமன்.</string>
    <string name="help_tip_title">உத்தி குறிப்பு</string>
    <string name="help_tip_body">ஒவ்வொரு கேள்வியும் எல்லோருக்கும் தெரியும் தகவல். உங்கள் நகர்வுகள் என்ன வெளிப்படுத்துகின்றன என்று யோசியுங்கள் — உங்கள் அணியினருக்கும், எதிராளிகளுக்கும்.</string>

    <!-- Tutorial tooltips -->
    <string name="tutorial_score_bar">எதிரணிக்கு எதிராக உங்கள் அணி எப்படி ஆடுகிறது என்று பாருங்கள்.</string>
    <string name="tutorial_turn_banner">தற்போதைய முறையையும் மீதமுள்ள நேரத்தையும் காட்டுகிறது.\n கடைசி 15 வினாடிகளுக்கு டைமர் தெரியும்.</string>
    <string name="tutorial_players">எல்லா வீரர்களையும் அவர்களின் சீட்டு எண்ணிக்கையையும் பாருங்கள்.</string>
    <string name="tutorial_half_suits">எந்த ஹாஃப்-சூட்கள் க்ளெய்ம் ஆயின அல்லது எடுக்கப்பட்டன என்று கண்காணியுங்கள்.</string>
    <string name="tutorial_hand_tab">உங்கள் கையில் உள்ள சீட்டுகளைப் பார்க்க இங்கே தட்டுங்கள்.</string>
    <string name="tutorial_your_hand">இவை உங்கள் சீட்டுகள், ஹாஃப்-சூட் வாரியாக. கேட்கவும் க்ளெய்ம் செய்யவும் இவற்றைப் பயன்படுத்துங்கள்!</string>
    <string name="tutorial_action_buttons">உங்கள் முறையில், சீட்டு கேட்கவோ ஹாஃப்-சூட்டைக் க்ளெய்ம் செய்யவோ இவற்றைப் பயன்படுத்துங்கள்.</string>
    <string name="tutorial_tap_continue">தொடர எங்கேனும் தட்டுங்கள்</string>
    <string name="tutorial_tap_hand_tab">↓  கீழே உள்ள கை டேபைத் தட்டுங்கள்  ↓</string>
    <string name="tutorial_skip">டுடோரியலைத் தவிர்</string>
    <string name="waiting_room_primer_title">Literature புதிதா?</string>
    <string name="waiting_room_primer_cta">ஆடுவது எப்படி என்று பாருங்கள்</string>
    <string name="cd_dismiss">மூடு</string>
    <string name="festival_independence_day">சுதந்திர தின வாழ்த்துகள்</string>
    <string name="result_debrief_title">அது உங்கள் முதல் ஆட்டம்!</string>
    <string name="result_debrief_body">நோக்கம்: எதிரணியை விட அதிக ஹாஃப்-சூட்களைக் க்ளெய்ம் செய்வது — மொத்தம் 8 உள்ளன. ஒரு ஹாஃப்-சூட்டை முழுமையாக்கத் தேவையான சீட்டுகளை எதிராளிகளிடம் கேட்டு, பிறகு க்ளெய்ம் செய்யுங்கள்.</string>


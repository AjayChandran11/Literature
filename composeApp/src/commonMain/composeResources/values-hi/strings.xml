    <!-- How to Play -->
    <string name="help_button_description">कैसे खेलें</string>
    <string name="help_title">कैसे खेलें</string>
    <string name="help_objective_title">लक्ष्य</string>
    <string name="help_objective_body">जीतने के लिए दूसरी टीम से ज़्यादा हाफ़-सूट क्लेम करें — कुल 8 होते हैं।</string>
    <string name="help_deck_title">गड्डी</string>
    <string name="help_deck_body">4 सूट में 48 पत्ते (♠&#xFE0F; ♥&#xFE0F; ♦&#xFE0F; ♣&#xFE0F;)। 8 नहीं होते।\n\nहर सूट दो हाफ़-सूट में बँटता है:\n• लो: 2, 3, 4, 5, 6, 7\n• हाई: 9, 10, J, Q, K, A\n\nयानी 6-6 पत्तों के 8 हाफ़-सूट।</string>
    <string name="help_teams_title">टीमें</string>
    <string name="help_teams_body">दो बराबर टीमें (2v2 या 3v3)। पत्ते सिर्फ़ विरोधियों से माँग सकते हैं — अपने साथियों से कभी नहीं।</string>
    <string name="help_asking_title">पत्ते माँगना</string>
    <string name="help_asking_body">अपनी बारी पर एक सूट चुनें, जो पत्ते चाहिए वे चुनें, और किसी विरोधी से माँगें।\n\nपत्ता मिला? फिर माँगें।\nनहीं मिला? अब उनकी बारी।\n\nमाँगने के लिए उस हाफ़-सूट का कम से कम एक पत्ता आपके पास होना चाहिए।</string>
    <string name="help_claiming_title">हाफ़-सूट क्लेम करना</string>
    <string name="help_claiming_body">लगता है पूरा हाफ़-सूट आपकी टीम के पास है? क्लेम करें — हर पत्ता सही साथी को सौंपें।\n\nसही हुआ तो आपकी टीम को पॉइंट।\nगलत हुआ तो दूसरी टीम को पॉइंट।</string>
    <string name="help_no_cards_title">पत्ते खत्म</string>
    <string name="help_no_cards_body">पत्ते खत्म हो गए? कोई बात नहीं — आपके साथी खेलते रहते हैं। आप अब भी क्लेम का हिस्सा बन सकते हैं।</string>
    <string name="help_winning_title">जीत</string>
    <string name="help_winning_body">जो टीम ज़्यादा हाफ़-सूट क्लेम करती है, वह जीतती है। 4–4 हुआ तो बराबरी।</string>
    <string name="help_tip_title">रणनीति टिप</string>
    <string name="help_tip_body">हर माँग सबको दिखती है। सोचें कि आपकी चालें क्या बताती हैं — आपके साथियों को भी, विरोधियों को भी।</string>

    <!-- Tutorial tooltips -->
    <string name="tutorial_score_bar">देखें कि विरोधियों के मुकाबले आपकी टीम कैसा खेल रही है।</string>
    <string name="tutorial_turn_banner">मौजूदा बारी और बचा हुआ समय दिखाता है।\n आखिरी 15 सेकंड में टाइमर दिखेगा।</string>
    <string name="tutorial_players">सभी खिलाड़ी और उनके पत्तों की गिनती देखें।</string>
    <string name="tutorial_half_suits">देखें कौन से हाफ़-सूट क्लेम हो चुके हैं या लिए जा चुके हैं।</string>
    <string name="tutorial_hand_tab">अपने हाथ के पत्ते देखने के लिए यहाँ टैप करें।</string>
    <string name="tutorial_your_hand">ये आपके पत्ते हैं, हाफ़-सूट के हिसाब से। इनसे माँगें और क्लेम करें!</string>
